# Flask application secret.
# Generate a secure random value for your actual .env file.
SECRET_KEY=

# Database connection
DATABASE_URL=sqlite:///evoting.db

# Fernet encryption key for TOTP secrets.
# Generate a valid Fernet key for your actual .env file.
TOTP_ENCRYPTION_KEY=

# R7: Comma-separated approved IP addresses or CIDR ranges
# for diplomatic terminals. Leave blank until approved ranges
# are supplied by the deployment administrator.
DIPLOMATIC_TERMINAL_ALLOWED_CIDRS=

# R8: Secure session cookies.
# Keep true in production when using HTTPS.
SESSION_COOKIE_SECURE=true
